{
    "name": "@odiseoteam/sulu-site-assistant-widget",
    "private": true,
    "description": "Chat widget of the Sulu site assistant: sources in assets/widget, built into public/. The admin views are assets/admin.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build:js": "esbuild assets/widget/entry.js --bundle --minify --format=esm --target=es2020 --outfile=public/widget.js",
        "build:css": "sass --no-source-map --style=compressed assets/widget/styles/site-assistant.scss public/widget.css",
        "build": "npm run build:js && npm run build:css",
        "test": "vitest run"
    },
    "devDependencies": {
        "@hotwired/stimulus": "^3.2.2",
        "esbuild": "^0.25.0",
        "jsdom": "^26.1.0",
        "sass": "^1.93.0",
        "vitest": "^3.2.4"
    }
}
