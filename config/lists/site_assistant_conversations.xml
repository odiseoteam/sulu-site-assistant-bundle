<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>site_assistant_conversations</key>

    <properties>
        <property name="id" visibility="no" translation="sulu_admin.id">
            <field-name>id</field-name>
            <entity-name>%odiseo_sulu_site_assistant.model.conversation.class%</entity-name>
        </property>

        <property name="createdAt" visibility="always" translation="odiseo_site_assistant.started" sortable="true">
            <field-name>createdAt</field-name>
            <entity-name>%odiseo_sulu_site_assistant.model.conversation.class%</entity-name>
            <transformer type="datetime"/>
        </property>

        <property name="firstMessage" visibility="always" translation="odiseo_site_assistant.first_message" searchability="yes">
            <field-name>firstMessage</field-name>
            <entity-name>%odiseo_sulu_site_assistant.model.conversation.class%</entity-name>
        </property>

        <property name="turnCount" visibility="always" translation="odiseo_site_assistant.turns" sortable="true">
            <field-name>turnCount</field-name>
            <entity-name>%odiseo_sulu_site_assistant.model.conversation.class%</entity-name>
        </property>

        <property name="locale" visibility="yes" translation="sulu_admin.language" sortable="true">
            <field-name>locale</field-name>
            <entity-name>%odiseo_sulu_site_assistant.model.conversation.class%</entity-name>
        </property>

        <property name="handoffShownAt" visibility="yes" translation="odiseo_site_assistant.handoff_shown" sortable="true">
            <field-name>handoffShownAt</field-name>
            <entity-name>%odiseo_sulu_site_assistant.model.conversation.class%</entity-name>
            <transformer type="datetime"/>
        </property>

        <property name="handoffClickedAt" visibility="yes" translation="odiseo_site_assistant.handoff_clicked" sortable="true">
            <field-name>handoffClickedAt</field-name>
            <entity-name>%odiseo_sulu_site_assistant.model.conversation.class%</entity-name>
            <transformer type="datetime"/>
        </property>

        <property name="lastPage" visibility="no" translation="odiseo_site_assistant.last_page" searchability="yes">
            <field-name>lastPage</field-name>
            <entity-name>%odiseo_sulu_site_assistant.model.conversation.class%</entity-name>
        </property>

        <property name="updatedAt" visibility="no" translation="odiseo_site_assistant.last_activity" sortable="true">
            <field-name>updatedAt</field-name>
            <entity-name>%odiseo_sulu_site_assistant.model.conversation.class%</entity-name>
            <transformer type="datetime"/>
        </property>
    </properties>
</list>
