<?xml version="1.0" ?>
<!-- Served by the editable controller from the configuration and the versions: no entity behind the list. -->
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>site_assistant_rules</key>

    <properties>
        <property name="id" visibility="no" translation="odiseo_site_assistant.code"/>
        <property name="title" visibility="always" translation="odiseo_site_assistant.title"/>
        <property name="group" visibility="always" translation="odiseo_site_assistant.category"/>
        <property name="enabled" visibility="always" translation="odiseo_site_assistant.enabled">
            <transformer type="bool"/>
        </property>
        <property name="origin" visibility="yes" translation="odiseo_site_assistant.origin"/>
        <property name="version" visibility="yes" translation="odiseo_site_assistant.version"/>
        <property name="draft" visibility="yes" translation="odiseo_site_assistant.draft">
            <transformer type="bool"/>
        </property>
        <property name="changed" visibility="yes" translation="odiseo_site_assistant.last_change">
            <transformer type="datetime"/>
        </property>
        <property name="changer" visibility="no" translation="odiseo_site_assistant.changed_by"/>
    </properties>
</list>
