<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- Mapped superclass: MappedSuperclassListener turns the configured model into the entity.
         The core's columns are inherited. -->
    <mapped-superclass name="Odiseo\SuluSiteAssistantBundle\Entity\Conversation" table="sa_conversation">
        <indexes>
            <index name="idx_sa_conversation_created" columns="created_at" />
        </indexes>

        <field name="locale" column="locale" type="string" length="16" nullable="true" />
        <field name="webspaceKey" column="webspace_key" type="string" length="64" nullable="true" />
        <field name="firstMessage" column="first_message" type="string" length="255" nullable="true" />
        <field name="lastPage" column="last_page" type="string" length="255" nullable="true" />
        <field name="turnCount" column="turn_count" type="integer">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="handoffShownAt" column="handoff_shown_at" type="datetime_immutable" nullable="true" />
        <field name="handoffClickedAt" column="handoff_clicked_at" type="datetime_immutable" nullable="true" />
    </mapped-superclass>
</doctrine-mapping>
