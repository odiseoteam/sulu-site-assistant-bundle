{# Site assistant widget: floating launcher and panel. Strings live under
   `odiseo_sulu_site_assistant.`; the ones the JS needs go in `i18n` as a flat dictionary, so the
   browser needs no translation runtime. Nothing here reads the session: the page stays cacheable.

   Override pieces in templates/bundles/OdiseoSuluSiteAssistantBundle/: launcher_icon, brand,
   widget_foot and activity_indicator, or this whole template. #}
{% set prefix = 'odiseo_sulu_site_assistant.' %}
{% set i18n = {} %}
{% for key in js_keys %}
    {% set translated = (prefix ~ key)|trans({}, 'messages', locale) %}
    {% if translated != prefix ~ key %}
        {% set i18n = i18n|merge({ (key): translated }) %}
    {% endif %}
{% endfor %}
{# Each path brings its own texts; heading and text are optional. #}
{% for path in handoff_paths %}
    {% for key in ['card.handoff.path.' ~ path, 'card.handoff.heading.' ~ path, 'card.handoff.text.' ~ path] %}
        {% set text = (prefix ~ key)|trans({}, 'messages', locale) %}
        {% if text != prefix ~ key %}{% set i18n = i18n|merge({ (key): text }) %}{% endif %}
    {% endfor %}
{% endfor %}
<link rel="stylesheet" href="{{ asset('bundles/odiseosulusiteassistant/widget.css') }}">
<script type="module" src="{{ asset('bundles/odiseosulusiteassistant/widget.js') }}"></script>
<div class="agent-widget{{ showcase ? ' agent-widget--showcase' : '' }}"
     data-controller="site-assistant"
     {% if restricted %}hidden{% endif %}
     {% if showcase %}data-site-assistant-showcase-value="{{ showcase|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}"{% endif %}
     data-site-assistant-i18n-value="{{ i18n|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}"
     data-site-assistant-locale-value="{{ locale }}"
     data-site-assistant-webspace-value="{{ webspace }}"
     data-site-assistant-contact-links-value="{{ contact_links|json_encode(constant('JSON_FORCE_OBJECT')) }}"
     data-site-assistant-link-hosts-value="{{ link_hosts|json_encode }}"
     data-site-assistant-restricted-value="{{ restricted ? 'true' : 'false' }}"
     data-site-assistant-access-cookie-value="{{ access_cookie }}"
     data-site-assistant-session-url-value="{{ path('odiseo_ai_conversational_agent_session_start') }}"
     data-site-assistant-chat-url-value="{{ path('odiseo_ai_conversational_agent_chat') }}"
     data-site-assistant-contact-url-value="{{ path('odiseo_sulu_site_assistant_agent_contact_link') }}">

    {# A prompt over the launcher once it folds, until the chat opens or the X closes it for the
       visit. An empty translation turns it off. #}
    {% set nudge = (prefix ~ 'widget.nudge.text')|trans({}, 'messages', locale) %}
    {% if nudge is not empty and nudge != prefix ~ 'widget.nudge.text' and not showcase %}
        <div class="agent-widget__nudge" data-site-assistant-target="nudge" hidden>
            <button type="button" class="agent-widget__nudge-text" data-action="site-assistant#toggle">{{ nudge }}</button>
            <button type="button" class="agent-widget__nudge-close" data-action="site-assistant#dismissNudge"
                    aria-label="{{ (prefix ~ 'widget.nudge.close')|trans({}, 'messages', locale) }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.4 19 5 17.6l5.6-5.6L5 6.4 6.4 5l5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19Z"/></svg>
            </button>
        </div>
    {% endif %}

    <button type="button" class="agent-widget__launcher" data-site-assistant-target="launcher"
            data-action="site-assistant#toggle" aria-expanded="false" aria-controls="site-assistant-panel">
        <span class="agent-widget__launcher-icon">{% include '@OdiseoSuluSiteAssistant/launcher_icon.html.twig' %}</span>
        <span class="agent-widget__launcher-label"><span>{{ (prefix ~ 'widget.launcher')|trans({}, 'messages', locale) }}</span></span>
    </button>

    <section id="site-assistant-panel" class="agent-widget__panel" data-site-assistant-target="panel" hidden
             role="dialog" aria-label="{{ assistant_name ?: (prefix ~ 'widget.dialog_label')|trans({}, 'messages', locale) }}">
        <header class="agent-widget__head">
            {# Hidden on mobile, where the panel already fills the screen. #}
            <button type="button" class="agent-widget__icon agent-widget__expand" data-site-assistant-target="expand"
                    data-action="site-assistant#toggleWide" aria-pressed="false"
                    aria-label="{{ (prefix ~ 'widget.expand')|trans({}, 'messages', locale) }}">
                {# Material Symbols open_in_full / close_fullscreen (Apache 2.0). #}
                <svg class="agent-widget__expand-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21v-8h2v4.6L17.6 5H13V3h8v8h-2V6.4L6.4 19H11v2H3Z"/></svg>
                <svg class="agent-widget__expand-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.4 22 2 20.6 8.6 14H4v-2h8v8h-2v-4.6L3.4 22ZM12 12V4h2v4.6L20.6 2 22 3.4 15.4 10H20v2h-8Z"/></svg>
            </button>

            <div class="agent-widget__brand">{% include '@OdiseoSuluSiteAssistant/brand.html.twig' %}</div>

            <div class="agent-widget__actions">
                {% if new_chat_button %}
                    {# Shown once the thread has a message; starts over with a new session. #}
                    <button type="button" class="agent-widget__icon" data-site-assistant-target="newChat"
                            data-action="site-assistant#startOver" hidden
                            aria-label="{{ (prefix ~ 'widget.new_chat')|trans({}, 'messages', locale) }}" title="{{ (prefix ~ 'widget.new_chat')|trans({}, 'messages', locale) }}">
                        {# Material Icons add_comment (Apache 2.0). #}
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 4c0-1.1-.9-2-2-2H4c-1.1 0-1.99.9-1.99 2L2 16c0 1.1.9 2 2 2h14l4 4V4zm-2 13.17L18.83 16H4V4h16v13.17zM13 5h-2v4H7v2h4v4h2v-4h4V9h-4z"/></svg>
                    </button>
                {% endif %}

                <button type="button" class="agent-widget__icon" data-action="site-assistant#toggle"
                        aria-label="{{ (prefix ~ 'widget.close')|trans({}, 'messages', locale) }}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.4 19 5 17.6l5.6-5.6L5 6.4 6.4 5l5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19Z"/></svg>
                </button>
            </div>
        </header>

        <template data-site-assistant-target="indicator">{% include '@OdiseoSuluSiteAssistant/activity_indicator.html.twig' %}</template>

        <div class="agent-widget__thread" data-site-assistant-target="thread" data-action="scroll->site-assistant#trackScroll" aria-live="polite">
            <div class="agent-widget__welcome" data-site-assistant-target="welcome">
                <p class="agent-widget__welcome-title">{{ welcome_title ?: (prefix ~ 'widget.welcome.title')|trans({}, 'messages', locale) }}</p>
                <p>{{ welcome_body ?: (prefix ~ 'widget.welcome.body')|trans({}, 'messages', locale) }}</p>
            </div>

            {# Starter chips: the page's or the webspace's when set, else the translated defaults.
               Each turn replaces them and moves them below its answer. A default without a
               translation is skipped. #}
            <div class="agent-widget__chips" data-site-assistant-target="chips" data-action="click->site-assistant#pick">
                {% if chips is not empty %}
                    {% for chip in chips %}
                        <button type="button" class="agent-chip">{{ chip }}</button>
                    {% endfor %}
                {% else %}
                    {% for chip in ['first', 'second', 'third', 'fourth', 'fifth'] %}
                        {% set chip_key = prefix ~ 'widget.chips.' ~ chip %}
                        {% set label = chip_key|trans({}, 'messages', locale) %}
                        {% if label != chip_key %}
                            <button type="button" class="agent-chip">{{ label }}</button>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        <div class="agent-widget__foot">
            {# Back to the latest message, shown once the reader scrolled up. #}
            <button type="button" class="agent-widget__jump" data-site-assistant-target="jump" data-action="site-assistant#jump"
                    aria-label="{{ (prefix ~ 'widget.jump')|trans({}, 'messages', locale) }}" title="{{ (prefix ~ 'widget.jump')|trans({}, 'messages', locale) }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            </button>

            <form class="agent-widget__composer" data-site-assistant-target="form" data-action="site-assistant#send">
                <label class="agent-visually-hidden" for="site-assistant-input">{{ (prefix ~ 'widget.input.label')|trans({}, 'messages', locale) }}</label>
                <textarea id="site-assistant-input" rows="1" maxlength="1000" autocomplete="off"
                          placeholder="{{ (prefix ~ 'widget.input.placeholder')|trans({}, 'messages', locale) }}"
                          data-site-assistant-target="input"
                          data-action="keydown->site-assistant#keydown input->site-assistant#draft"></textarea>
                <button type="submit" class="agent-widget__send" data-site-assistant-target="submit" aria-label="{{ (prefix ~ 'widget.send')|trans({}, 'messages', locale) }}" disabled>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
                </button>
            </form>

            {% include '@OdiseoSuluSiteAssistant/widget_foot.html.twig' %}
        </div>
    </section>
</div>
